# Basic local development
CLASSSTATUS_STORAGE_DRIVER=local-json
# Optional. Defaults to ./data; generated contents are intentionally ignored by Git.
CLASSSTATUS_DATA_DIR=./data
# Exact browser origin, without a path.
CLASSSTATUS_PUBLIC_ORIGIN=http://localhost:3000

# Optional local administrator access
# Generate the hash with: npm run admin:hash-password
CLASSSTATUS_ADMIN_USERNAME=
CLASSSTATUS_ADMIN_PASSWORD_HASH=
# Base64-encoded random bytes; generate at least 32 bytes.
CLASSSTATUS_SESSION_SECRET=

# Hosted/Supabase configuration
# Change CLASSSTATUS_STORAGE_DRIVER above to supabase when using this section.
# These values are server-only; do not create NEXT_PUBLIC_ variants.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CLASSSTATUS_ADMIN_USER_ID=
# Base64-encoded random policy pepper of at least 32 bytes. This is not an Auth token.
CLASSSTATUS_SECURITY_PEPPER=
# Base64url-encoded value containing at least 32 random bytes. Store the matching
# hosted-environment value in the namespace-specific Supabase Vault entry.
CLASSSTATUS_CRON_SECRET=
# Non-Vercel contract tests may set this explicitly. Hosted deployments derive
# their namespace from trusted platform environment metadata.
CLASSSTATUS_SUPABASE_NAMESPACE=preview

# Web Push
# Generate VAPID keys with: npx web-push generate-vapid-keys
# The public key is returned only from the alert configuration endpoint; never expose
# the private key to browser code.
CLASSSTATUS_VAPID_PUBLIC_KEY=
CLASSSTATUS_VAPID_PRIVATE_KEY=
CLASSSTATUS_VAPID_SUBJECT=mailto:alerts@example.com
