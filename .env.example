# ClassStatus local development — copy to .env.local
CLASSSTATUS_STORAGE_DRIVER=local-json
CLASSSTATUS_DATA_DIR=./data
CLASSSTATUS_PUBLIC_ORIGIN=http://localhost:3000

# Optional local admin credentials (required for /collector)
# Generate hash: npm run admin:hash-password
CLASSSTATUS_ADMIN_USERNAME=
CLASSSTATUS_ADMIN_PASSWORD_HASH=
# Base64-encoded random 32+ bytes, generated with Node crypto
CLASSSTATUS_SESSION_SECRET=

# Optional Web Push for local testing (use a supported browser)
CLASSSTATUS_VAPID_PUBLIC_KEY=
CLASSSTATUS_VAPID_PRIVATE_KEY=
CLASSSTATUS_VAPID_SUBJECT=mailto:alerts@example.com

# Optional local portfolio embeds
PORTFOLIO_ORIGIN=
PORTFOLIO_DEV_ORIGIN=
