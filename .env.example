# Server-only administrator configuration. Never prefix these with NEXT_PUBLIC_.
CLASSSTATUS_ADMIN_USERNAME=
CLASSSTATUS_ADMIN_PASSWORD_HASH=
# Base64-encoded random bytes; generate at least 32 bytes.
CLASSSTATUS_SESSION_SECRET=
# Exact browser origin, without a path (for example http://localhost:3000).
CLASSSTATUS_PUBLIC_ORIGIN=
# Development/test only. Vercel production rejects local-json.
CLASSSTATUS_STORAGE_DRIVER=local-json
