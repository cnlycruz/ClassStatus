# Local development (local JSON + Argon2). Never use these values on Vercel.
CLASSSTATUS_STORAGE_DRIVER=local-json
CLASSSTATUS_ADMIN_USERNAME=
CLASSSTATUS_ADMIN_PASSWORD_HASH=
# Base64-encoded random bytes; generate at least 32 bytes.
CLASSSTATUS_SESSION_SECRET=
# Exact browser origin, without a path (for example http://localhost:3000).
CLASSSTATUS_PUBLIC_ORIGIN=

# Supabase-backed Vercel Preview/Production. All values are server-only; do not
# add NEXT_PUBLIC_ variants. Vercel must set CLASSSTATUS_STORAGE_DRIVER=supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CLASSSTATUS_ADMIN_USER_ID=
# Base64-encoded random policy pepper of at least 32 bytes. This is not an Auth token.
CLASSSTATUS_SECURITY_PEPPER=
# Base64url-encoded value containing at least 32 random bytes. Configure only for
# the scheduled Preview collector and store the matching value in Supabase Vault.
CLASSSTATUS_CRON_SECRET=

# Server-only Supabase secret key reserved for the Production storage path.
# Never configure this for Preview; scheduled Preview collector calls use the
# publishable key plus narrowly scoped signed RPC capabilities.
# Never expose it through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Non-Vercel Supabase contract tests only. Vercel derives preview/production from
# its trusted VERCEL_ENV and ignores this override.
CLASSSTATUS_SUPABASE_NAMESPACE=preview
